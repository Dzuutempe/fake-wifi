<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ Dzuu Portal Server"
        android:textColor="#38bdf8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status Server: OFF"
        android:textColor="#ef4444"
        android:textSize="14sp"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Custom HTML / Pesan Prank Korban:"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/edtHtml"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#1e293b"
        android:textColor="#f8fafc"
        android:textColorHint="#64748b"
        android:padding="12dp"
        android:gravity="top|start"
        android:textSize="13sp"
        android:fontFamily="monospace"
        android:text="&lt;h1 style='color:red; text-align:center;'&gt;WIFIMU DIHACK DZUU!&lt;/h1&gt;"
        android:layout_marginBottom="16dp"/>

    <Button
        android:id="@+id/btnToggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="START SERVER"
        android:backgroundTint="#38bdf8"
        android:textColor="#0f172a"
        android:textStyle="bold"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Live Target Logs:"
        android:textColor="#94a3b8"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#1e293b"
        android:padding="8dp">
        <TextView
            android:id="@+id/txtLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="> Siap dijalankan...\n"
            android:textColor="#38bdf8"
            android:textSize="11sp"
            android:fontFamily="monospace"/>
    </ScrollView>

</LinearLayout>
        
